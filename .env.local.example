# =============================================================================
# LOG SERVICE - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Áp dụng: cp .env.local.example .env
ASPNETCORE_ENVIRONMENT=Development
LOG_SERVICE_PORT=8004

# Database Connection (Local Docker PostgreSQL: Port 5436)
CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_DB_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
