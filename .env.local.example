# =============================================================================
# NEXUS LOG SERVICE - ENVIRONMENT (.env.local.example)
# =============================================================================
# DB local (cụm src/Infrastructure/databases). Hạ tầng dùng chung nexus-network.

ASPNETCORE_ENVIRONMENT=Development
LOG_SERVICE_PORT=8004

# Database (Neon Cloud PostgreSQL)
LOG_DB_CONNECTION=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres

# Internal service-to-service authentication
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
