# =============================================================================
# ENVIRONMENT VARIABLES FOR LOG SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
LOG_SERVICE_PORT=8004

# Database Connection (Local PostgreSQL - Port 5436)
CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_DB_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# RabbitMQ (Docker network: rabbitmq; Local host: localhost)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
