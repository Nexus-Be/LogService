# =============================================================================
# ENVIRONMENT VARIABLES FOR LOG SERVICE (.env.example)
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
LOG_SERVICE_PORT=8004
LOG_DB_PORT=5436

# Database Connection (Neon Cloud PostgreSQL)
CONNECTION_STRING=Host=ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
LOG_CONNECTION_STRING=Host=ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Database (PostgreSQL Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
