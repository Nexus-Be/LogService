# =============================================================================
# ENVIRONMENT VARIABLES FOR LOG SERVICE (.env.example)
# =============================================================================
# Hỗ trợ 2 hồ sơ môi trường:
#   1. Local DB (PostgreSQL Cục bộ port 5436): cp .env.local.example .env
#   2. Server DB (PostgreSQL Neon Cloud):      cp .env.server.example .env
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
LOG_SERVICE_PORT=8004

# Database Connection (Mặc định Local DB)
CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_DB_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
